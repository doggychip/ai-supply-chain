+function resolveNewMcap({ real, price, oldMcap, oldPrice }) {
+  // 1. Real marketCap reported by Yahoo (strongly preferred).
+  if (real && typeof real.marketCap === 'number' && real.marketCap > 0) {
+    return real.marketCap;
