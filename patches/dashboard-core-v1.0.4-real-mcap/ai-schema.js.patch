+  // 2. price * sharesOutstanding (drift-free as long as shares is fresh).
+  if (real && typeof real.sharesOutstanding === 'number' && real.sharesOutstanding > 0 &&
+      typeof price === 'number' && price > 0) {
+    return price * real.sharesOutstanding;
+  }
+  // 3. Legacy fallback: ratio-scale the previous mcap by the price ratio.
+  if (typeof oldMcap === 'number' && oldMcap > 0 &&
+      typeof price === 'number' && price > 0 &&
+      typeof oldPrice === 'number' && oldPrice > 0) {
+    return oldMcap * (price / oldPrice);
+  }
+  return null;
