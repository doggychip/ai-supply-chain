@@ -2637,6 +2643,65 @@ function goDash(target) {
 <!-- Dashboard Enhancements: Search, Watchlist, Dark Mode, Compare -->
 <link rel="stylesheet" href="dashboard_enhancements.css">
 <script src="dashboard_enhancements.js"></script>
+<!-- SW conviction-card price sync — walks every .cv-card and overwrites
+     its .cv-price + .cv-price-chg from SW_DATA.tickers[ticker]. Runs on load
+     (so initial render matches sw_data.json baseline, not the hardcoded HTML
+     prices) and on every /api/quotes refresh via window.dashboardRenderers. -->
+<script>
+(function () {
+  function syncConvictionCardPrices() {
+    if (typeof SW_DATA === 'undefined' || !SW_DATA.tickers) return;
+    document.querySelectorAll('.cv-card').forEach(function (card) {
+      var tEl = card.querySelector('.cv-card-ticker');
+      if (!tEl) return;
+      var ticker = (tEl.textContent || '').trim();
+      var d = SW_DATA.tickers[ticker];
+      if (!d) return;
+
+      var priceEl = card.querySelector('.cv-price');
+      if (priceEl && typeof d.price === 'number' && d.price > 0) {
+        priceEl.textContent = '$' + d.price.toFixed(2);
+      }
+      var chgEl = card.querySelector('.cv-price-chg');
+      if (chgEl && typeof d.change === 'number' && typeof d.changePct === 'number') {
+        var up = d.change >= 0;
+        chgEl.className = 'cv-price-chg ' + (up ? 'up' : 'dn');
+        var sign = up ? '+' : '';
+        chgEl.textContent =
+          sign + d.change.toFixed(2) + ' (' + sign + d.changePct.toFixed(2) + '%)';
+      }
+    });
+  }
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', syncConvictionCardPrices);
+  } else {
+    syncConvictionCardPrices();
+  }
+  (window.dashboardRenderers = window.dashboardRenderers || []).push(syncConvictionCardPrices);
+})();
+</script>
+
+<!-- Auto-update any element with data-dynamic-date so "Apr 2026" / "Apr 16, 2026"
+     stay current without manual edits. setInterval re-stomps every 2s so i18n
+     language switches can't overwrite us with the original key. -->
+<script>
+(function () {
+  function refreshDynamicDates() {
+    var now = new Date();
+    var full = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+    var monthYear = now.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
+    document.querySelectorAll('[data-dynamic-date="full"]').forEach(function (el) { el.textContent = full; });
+    document.querySelectorAll('[data-dynamic-date="month-year"]').forEach(function (el) { el.textContent = monthYear; });
+  }
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', refreshDynamicDates);
+  } else {
+    refreshDynamicDates();
+  }
+  setInterval(refreshDynamicDates, 2000);
+})();
+</script>
+<script src="/live-prices.js"></script>
 <script src="bootstrap-quotes.js"></script>
